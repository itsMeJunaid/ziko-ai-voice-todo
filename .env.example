# Copy to .env (never commit .env). Used by spikes/ and by `uv run` in backend/ during development.
# In the packaged app the Gemini key lives in the OS credential store (keyring), not in a file.

GEMINI_API_KEY=
ZIKO_GEMINI_MODEL=gemini-3.8-live
ZIKO_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Wake word engine: livekit (default, open source, no key) or porcupine (fallback)
ZIKO_WAKEWORD_ENGINE=livekit
# LiveKit wakeword: ONNX classifier trained with `livekit-wakeword run spikes/hey_ziko.yaml`
ZIKO_WAKEWORD_ONNX=./spikes/out/hey_ziko/hey_ziko.onnx
ZIKO_WAKEWORD_THRESHOLD=0.8

# Porcupine fallback only (free personal tier key: https://console.picovoice.ai)
PICOVOICE_ACCESS_KEY=
ZIKO_WAKEWORD_PPN=./spikes/hey_ziko_windows.ppn

# Backend (dev only; Tauri injects random values in production)
ZIKO_PORT=8765
ZIKO_TOKEN=dev-token-change-me
ZIKO_DEBUG_CONTENT=0
