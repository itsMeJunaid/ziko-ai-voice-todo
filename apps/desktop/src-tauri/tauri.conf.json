{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziko",
  "mainBinaryName": "ziko",
  "version": "0.1.3",
  "identifier": "com.ziko.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dot",
        "title": "Ziko",
        "url": "index.html#/dot",
        "width": 64,
        "height": 64,
        "resizable": true,
        "minWidth": 64,
        "minHeight": 64,
        "maxWidth": 64,
        "maxHeight": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "panel",
        "title": "Ziko Panel",
        "url": "index.html#/panel",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "minWidth": 360,
        "minHeight": 540,
        "maxWidth": 640,
        "maxHeight": 1000
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ziko-backend"
    ],
    "shortDescription": "Floating voice to-do assistant",
    "longDescription": "Ziko is a floating desktop dot that manages your tasks and reminders, by voice (Gemini Live) or by hand.",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": ["libportaudio2"]
      }
    }
  }
}
